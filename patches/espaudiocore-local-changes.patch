+esp_err_t audio_player_probe_file(const char *path, i2s_chan_handle_t tx,
+                                  const espaudiocore_cfg_t *cfg, int *dec_err)
+{
+    if (dec_err) *dec_err = AUDIO_DEC_ERR_NONE;
+    if (!path || path[0] != '/') return ESP_ERR_INVALID_ARG;
+    if (s_ctx) return ESP_ERR_INVALID_STATE; /* stop playback first */
+
+    AudioInput *in = audio_source_fs_create(path);
+    if (!in) return ESP_ERR_NOT_FOUND;
+    const audio_decoder_entry_t *entry = audio_decoder_route(in, path);
+    if (!entry || !entry->create) {
+        delete in;
+        if (dec_err) *dec_err = AUDIO_DEC_ERR_OPEN;
+        return ESP_ERR_NOT_SUPPORTED;
+    }
+
+    PlayerCtx *c = new (std::nothrow) PlayerCtx();
+    if (!c) {
+        delete in;
+        return ESP_ERR_NO_MEM;
+    }
+    if (cfg) c->cfg = *cfg;
+    c->in = in;
+    c->duration_ms = -1;
+    c->dec = entry->create();
+    if (!c->dec) {
+        ctx_destroy(c);
+        if (dec_err) *dec_err = AUDIO_DEC_ERR_OPEN;
+        return ESP_ERR_NOT_SUPPORTED;
+    }
+    c->sink = audio_sink_i2s_create(tx, 0, c->cfg.output_bits);
+    if (!c->sink) {
+        ctx_destroy(c);
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    audio_format_t fmt = {};
+    audio_err_t r = c->dec->open(c->in, c->sink, PlayerCtx::meta_trampoline,
+                                 c, &fmt, &c->duration_ms, &c->dec_err);
+    esp_err_t err = (r == AUDIO_OK) ? ESP_OK : audio_err_to_esp(r);
+    if (dec_err) *dec_err = c->dec_err;
+    ctx_destroy(c);
+    return err;
+}

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
/build/
/build-logs/

# ESP-IDF component manager downloads; dependencies.lock stays tracked.
/managed_components/

# ---------------------------------------------------------------------------
# Generated / local configuration
# ---------------------------------------------------------------------------
/sdkconfig.old
/.vscode/

# ---------------------------------------------------------------------------
# Local artifacts and logs
# ---------------------------------------------------------------------------
/back_up.bin
/uart-log.txt
/*.obj
*.exe
__pycache__/
*.pyc
Thumbs.db
.DS_Store

# ---------------------------------------------------------------------------
# Third-party reference checkout (large, not part of the build)
# ---------------------------------------------------------------------------
/vendor_ref/

# Rendered datasheet pages, regenerated by tools/render_pdf_pages.py
/doc/render/

# ---------------------------------------------------------------------------
# Proprietary font and the data generated from it
#
# assets/zh-cn.ttf (SDK_SC_Web Heavy, HANYI) is not redistributable without a
# licence review; font_data/*.bin are rasterised from it.  See
# doc/FONT_PARTITION.md for how to regenerate them from a licensed copy.
# ---------------------------------------------------------------------------
/assets/zh-cn.ttf
/font_data/*.bin
